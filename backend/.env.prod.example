# =====================================================================
# PRODUÇÃO — copie para backend/.env na VPS e preencha os valores reais.
#   cp backend/.env.prod.example backend/.env
# Troque SECRET_KEY e a senha do Postgres por valores fortes.
# =====================================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=TROQUE-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=False

# Domínio público (subdomínio do tunnel) + hosts internos do Docker.
# Ex.: loja.seudominio.com
DJANGO_ALLOWED_HOSTS=SEU-SUBDOMINIO.seudominio.com,proxy,backend,localhost,127.0.0.1

# CSRF: precisa da URL https completa do subdomínio (Django admin/uploads).
DJANGO_CSRF_TRUSTED_ORIGINS=https://SEU-SUBDOMINIO.seudominio.com

# Database (Postgres) — troque a senha!
POSTGRES_DB=samarabeach
POSTGRES_USER=samarabeach
POSTGRES_PASSWORD=TROQUE-por-uma-senha-forte
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS — como a loja/painel chamam a API na MESMA origem (via proxy), o CORS
# praticamente não é usado. Mantido para chamadas diretas eventuais.
CORS_ALLOWED_ORIGINS=https://SEU-SUBDOMINIO.seudominio.com

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=600
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudflare Tunnel (modo token/dashboard) — cole o token do seu tunnel.
# cloudflared lê exatamente desta variável (TUNNEL_TOKEN).
TUNNEL_TOKEN=

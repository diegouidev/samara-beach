# =====================================================================
# PRODUÇÃO — copie para backend/.env na VPS e preencha os valores reais.
#   cp backend/.env.prod.example backend/.env
# Troque SECRET_KEY e a senha do Postgres por valores fortes.
# =====================================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=TROQUE-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=False

# Domínio público (subdomínio do tunnel) + hosts internos do Docker.
# Ex.: loja.seudominio.com
DJANGO_ALLOWED_HOSTS=SEU-SUBDOMINIO.seudominio.com,proxy,backend,localhost,127.0.0.1

# CSRF: precisa da URL https completa do subdomínio (Django admin/uploads).
DJANGO_CSRF_TRUSTED_ORIGINS=https://SEU-SUBDOMINIO.seudominio.com

# Database (Postgres) — troque a senha!
POSTGRES_DB=samarabeach
POSTGRES_USER=samarabeach
POSTGRES_PASSWORD=TROQUE-por-uma-senha-forte
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS — como a loja/painel chamam a API na MESMA origem (via proxy), o CORS
# praticamente não é usado. Mantido para chamadas diretas eventuais.
CORS_ALLOWED_ORIGINS=https://SEU-SUBDOMINIO.seudominio.com

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=600
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudflare Tunnel (modo token/dashboard) — cole o token do seu tunnel.
# cloudflared lê exatamente desta variável (TUNNEL_TOKEN).
TUNNEL_TOKEN=

# --- Loja online -------------------------------------------------------
# Kill switch da loja pública. Controlado só por quem tem acesso à VPS —
# a cliente não vê nem altera pelo painel.
#   true  = loja no ar normalmente
#   false = storefront vira página institucional (logo, endereço, horário,
#           redes e WhatsApp). O painel, PDV, caixa e estoque continuam
#           funcionando, e os pedidos online já recebidos seguem no painel.
# Depois de alterar:  docker compose up -d backend celery storefront
# ATENÇÃO: use `up -d`, não `restart`. O Compose injeta este arquivo como
# ambiente do container na criação — `restart` reaproveita o ambiente antigo
# e a mudança NÃO tem efeito. Recriar o storefront também limpa o cache do
# Next, tornando o corte imediato (sem isso, levaria até 60s).
# Obs.: desligar não invalida tokens de cliente já emitidos — eles apenas
# deixam de abrir qualquer porta, porque a API passa a responder 503.
LOJA_ONLINE_ATIVA=true

# --- Auditoria ---------------------------------------------------------
# Retenção da trilha por severidade (dias). O crítico (ajuste de estoque,
# reset de senha, mudança de papel, cancelamento de venda) segue o prazo
# prescricional tributário de 5 anos.
# O expurgo NÃO roda sozinho — o compose não sobe celery-beat. Agende na VPS:
#   0 3 * * 0 cd ~/samara-beach && docker compose exec -T backend \
#       python manage.py expurgar_auditoria
# Use --dry-run para ver quantos registros sairiam antes de apagar.
AUDIT_RETENCAO_INFO_DIAS=180
AUDIT_RETENCAO_ATENCAO_DIAS=730
AUDIT_RETENCAO_CRITICO_DIAS=1825

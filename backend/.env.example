# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (Postgres)
POSTGRES_DB=samarabeach
POSTGRES_USER=samarabeach
POSTGRES_PASSWORD=samarabeach
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS — origens dos frontends Next.js (storefront e painel)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Produção: token do Cloudflare Tunnel (usado pelo profile "tunnel" do compose)
CLOUDFLARE_TUNNEL_TOKEN=
